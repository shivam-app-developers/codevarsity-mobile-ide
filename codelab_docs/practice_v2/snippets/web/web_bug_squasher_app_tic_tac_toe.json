            {
              "label": "An empty board has no winner",
              "expr": "text('#out') === 'none'"
            },
            {
              "label": "A column of O still wins",
              "expr": "winner(['O', 'X', '', 'O', 'X', '', 'O', '', '']) === 'O'"
            }
          ]
        }
      ]
    }
  }
