{
  "visualizerType": "CodeRefactorChallenge",
  "visualizerParams": {
    "title": "Code Refactor: Name the rules",
    "language": "html",
    "problemDescription": "The handler tests the length and the digit in one long condition. Put them in named variables long and hasDigit so the rule reads like a sentence. The results must stay the same.",
    "initialCode": "<input id=\"pw\" placeholder=\"Password\">\n<p id=\"level\">Weak</p>\n<script>\n  var pw = document.getElementById('pw');\n  pw.addEventListener('input', function () {\n    var level = 'Weak';\n    if (pw.value.length >= 8 && /[0-9]/.test(pw.value)) level = 'Strong';\n    else if (pw.value.length >= 6) level = 'Medium';\n    document.getElementById('level').textContent = level;\n  });\n</script>",
    "solution": {
      "code": "<input id=\"pw\" placeholder=\"Password\">\n<p id=\"level\">Weak</p>\n<script>\n  var pw = document.getElementById('pw');\n  pw.addEventListener('input', function () {\n    var long = pw.value.length >= 8;\n    var okLength = pw.value.length >= 6;\n    var hasDigit = /[0-9]/.test(pw.value);\n    var level = 'Weak';\n    if (long && hasDigit) level = 'Strong';\n    else if (okLength) level = 'Medium';\n    document.getElementById('level').textContent = level;\n  });\n</script>",
      "explanation": "A condition with a name explains itself: \"long and has a digit\" is easier to read than the two comparisons behind it. The rules can also be reused or changed one at a time."
    },
    "validation": {
      "type": "run_output",
      "engine": "web",
      "tests": [
        {
          "width": 320,
          "checks": [
            {
              "label": "The meter starts at Weak",
              "expr": "text('#level') === 'Weak'"
            },
            {
              "label": "Six letters are Medium",
              "expr": "type('#pw', 'abcdef') && text('#level') === 'Medium'"
            },
            {
              "label": "Eight characters with a digit are Strong",
              "expr": "type('#pw', 'abcdefg1') && text('#level') === 'Strong'"
            },
            {
              "label": "Eight letters without a digit are Medium",
              "expr": "type('#pw', 'abcdefgh') && text('#level') === 'Medium'"
            }
          ]
        }
      ]
    }
  }
}
