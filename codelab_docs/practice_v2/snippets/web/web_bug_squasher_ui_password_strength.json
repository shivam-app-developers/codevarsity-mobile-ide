{
  "visualizerType": "BugSquasherScenario",
  "visualizerParams": {
    "title": "Bug Squasher: Six letters count as Weak",
    "language": "html",
    "problemDescription": "A password with exactly six characters is called Weak, though the rule says six or more is Medium. The comparison leaves out the boundary value.",
    "buggyCode": "<input id=\"p\" placeholder=\"Password\">\n<p id=\"out\">Weak</p>\n<script>\n  var p = document.getElementById('p');\n  p.addEventListener('input', function () {\n    var n = p.value.length;\n    document.getElementById('out').textContent = n > 6 ? 'Medium' : 'Weak';\n  });\n</script>",
    "solution": {
      "code": "<input id=\"p\" placeholder=\"Password\">\n<p id=\"out\">Weak</p>\n<script>\n  var p = document.getElementById('p');\n  p.addEventListener('input', function () {\n    var n = p.value.length;\n    document.getElementById('out').textContent = n >= 6 ? 'Medium' : 'Weak';\n  });\n</script>",
      "explanation": "n > 6 is false for exactly 6. When a rule says \"6 or more\", use >=. Boundary values are where most off-by-one bugs hide, so always test them."
    },
    "validation": {
      "type": "run_output",
      "engine": "web",
      "tests": [
        {
          "width": 320,
          "checks": [
            {
              "label": "Five letters are Weak",
              "expr": "type('#p', 'abcde') && text('#out') === 'Weak'"
            },
            {
              "label": "Six letters are Medium",
              "expr": "type('#p', 'abcdef') && text('#out') === 'Medium'"
            },
            {
              "label": "Seven letters are Medium",
              "expr": "type('#p', 'abcdefg') && text('#out') === 'Medium'"
            }
          ]
        }
      ]
    }
  }
}
