{
  "visualizerType": "GuidedPractice",
  "visualizerParams": {
    "title": "Guided Practice: Temperature Converter",
    "language": "html",
    "description": "Type a converter from Celsius to Fahrenheit with the formula F = C x 9 / 5 + 32. Round the result to one decimal with toFixed.",
    "ghostCode": "<input id=\"c\" value=\"100\">\n<button id=\"go\">Convert</button>\n<p id=\"out\"></p>\n<script>\n  document.getElementById('go').addEventListener('click', function () {\n    var c = Number(document.getElementById('c').value);\n    var f = c * 9 / 5 + 32;\n    document.getElementById('out').textContent = f.toFixed(1) + ' F';\n  });\n</script>",
    "validation": {
      "type": "run_output",
      "engine": "web",
      "tests": [
        {
          "width": 320,
          "checks": [
            {
              "label": "100 C is 212.0 F",
              "expr": "click('#go') && text('#out') === '212.0 F'"
            },
            {
              "label": "0 C is 32.0 F",
              "expr": "type('#c', '0') && click('#go') && text('#out') === '32.0 F'"
            },
            {
              "label": "-40 C is -40.0 F",
              "expr": "type('#c', '-40') && click('#go') && text('#out') === '-40.0 F'"
            }
          ]
        }
      ]
    }
  }
}
