{
  "visualizerType": "GuidedPractice",
  "visualizerParams": {
    "title": "Guided Practice: Password Strength Meter",
    "language": "html",
    "description": "Type a meter that says Weak, Medium or Strong as a password is typed. It looks at the length and at whether the password has a digit.",
    "ghostCode": "<input id=\"pw\" placeholder=\"Password\">\n<p id=\"level\">Weak</p>\n<script>\n  var pw = document.getElementById('pw');\n  pw.addEventListener('input', function () {\n    var v = pw.value;\n    var level = 'Weak';\n    if (v.length >= 8 && /[0-9]/.test(v)) level = 'Strong';\n    else if (v.length >= 6) level = 'Medium';\n    document.getElementById('level').textContent = level;\n  });\n</script>",
    "validation": {
      "type": "run_output",
      "engine": "web",
      "tests": [
        {
          "width": 320,
          "checks": [
            {
              "label": "The meter starts at Weak",
              "expr": "text('#level') === 'Weak'"
            },
            {
              "label": "Six letters are Medium",
              "expr": "type('#pw', 'abcdef') && text('#level') === 'Medium'"
            },
            {
              "label": "Eight characters with a digit are Strong",
              "expr": "type('#pw', 'abcdefg1') && text('#level') === 'Strong'"
            },
            {
              "label": "Eight letters without a digit are only Medium",
              "expr": "type('#pw', 'abcdefgh') && text('#level') === 'Medium'"
            }
          ]
        }
      ]
    }
  }
}
