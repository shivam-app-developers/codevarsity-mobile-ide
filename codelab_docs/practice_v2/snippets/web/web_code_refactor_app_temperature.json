{
  "visualizerType": "CodeRefactorChallenge",
  "visualizerParams": {
    "title": "Code Refactor: Two-way converter with one function",
    "language": "html",
    "problemDescription": "The page has the same formula written inline for two buttons. Move the formulas into two named functions toF and toC. The results shown must stay the same.",
    "initialCode": "<input id=\"v\" value=\"50\">\n<button id=\"f\">To F</button>\n<button id=\"c\">To C</button>\n<p id=\"out\"></p>\n<script>\n  var v = document.getElementById('v');\n  var out = document.getElementById('out');\n  document.getElementById('f').addEventListener('click', function () {\n    out.textContent = Number(v.value) * 9 / 5 + 32;\n  });\n  document.getElementById('c').addEventListener('click', function () {\n    out.textContent = (Number(v.value) - 32) * 5 / 9;\n  });\n</script>",
    "solution": {
      "code": "<input id=\"v\" value=\"50\">\n<button id=\"f\">To F</button>\n<button id=\"c\">To C</button>\n<p id=\"out\"></p>\n<script>\n  function toF(c) { return c * 9 / 5 + 32; }\n  function toC(f) { return (f - 32) * 5 / 9; }\n  var v = document.getElementById('v');\n  var out = document.getElementById('out');\n  document.getElementById('f').onclick = function () {\n    out.textContent = toF(Number(v.value));\n  };\n  document.getElementById('c').onclick = function () {\n    out.textContent = toC(Number(v.value));\n  };\n</script>",
      "explanation": "Each formula has a name that says what it does, and it is easy to check on its own. The handlers only connect the page to the functions."
    },
    "validation": {
      "type": "run_output",
      "engine": "web",
      "tests": [
        {
          "width": 320,
          "checks": [
            {
              "label": "50 to F is 122",
              "expr": "click('#f') && text('#out') === '122'"
            },
            {
              "label": "212 to C is 100",
              "expr": "type('#v', '212') && click('#c') && text('#out') === '100'"
            }
          ]
        }
      ]
    }
  }
}
