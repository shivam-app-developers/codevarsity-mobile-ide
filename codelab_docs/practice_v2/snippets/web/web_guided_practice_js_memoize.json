{
  "visualizerType": "GuidedPractice",
  "visualizerParams": {
    "title": "Guided Practice: Cache Results With Memoization",
    "language": "html",
    "description": "Type a function that remembers its answers. A repeated call with the same input returns the saved result instead of working again. The page counts how often the real work ran.",
    "ghostCode": "<p id=\"out\"></p>\n<script>\n  var cache = {};\n  var work = 0;\n  function square(n) {\n    if (n in cache) return cache[n];\n    work = work + 1;\n    cache[n] = n * n;\n    return cache[n];\n  }\n  square(4); square(4); square(5); square(4);\n  document.getElementById('out').textContent = work;\n</script>",
    "validation": {
      "type": "run_output",
      "engine": "web",
      "tests": [
        {
          "width": 320,
          "checks": [
            {
              "label": "The real work ran twice",
              "expr": "text('#out') === '2'"
            }
          ]
        }
      ]
    }
  }
}
